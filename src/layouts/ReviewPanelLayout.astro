---
import Layout from './Layout.astro';

interface Props {
	title?: string;
}

const { title = 'Panel de reseñas' } = Astro.props;
---

<Layout
	title={title}
	description="Panel privado de moderación de reseñas."
	canonicalPath="/reviews-panel"
	noindex
>
	<slot name="head" slot="head" />
	<div class="review-panel min-h-[100dvh] bg-base text-foreground">
		<slot />
	</div>
</Layout>

<style is:global>
	.review-panel {
		--panel-gutter: 1rem;
		--panel-touch: 2.75rem;

		caret-color: var(--color-accent);
		padding-left: env(safe-area-inset-left);
		padding-right: env(safe-area-inset-right);
		padding-bottom: env(safe-area-inset-bottom);
	}

	@media (min-width: 640px) {
		.review-panel {
			--panel-gutter: 1.5rem;
		}
	}

	.review-panel ::selection {
		background: rgb(226 184 87 / 0.35);
		color: var(--color-foreground);
	}
</style>

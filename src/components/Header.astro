---
import MenuButton from './MenuButton.astro';

const navLinks = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Experiencias', href: '/experiencias' },
	{ label: 'Equipo', href: '/equipo' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border-subtle bg-base/80 backdrop-blur-md">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3">
		<a href="/" class="flex shrink-0 items-center text-foreground">
			<span class="font-serif text-xl tracking-wide">
				Aeria <span class="text-accent">Trois</span>
			</span>
		</a>

		<div class="flex items-center gap-8">
			<nav class="hidden items-center gap-8 lg:flex" aria-label="Principal">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class="text-sm uppercase text-muted transition-colors hover:text-accent"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<a
				href="/contacto"
				class="hidden rounded-full border border-border px-4 py-2 text-sm text-foreground transition-colors hover:border-accent hover:text-accent lg:inline-flex"
			>
				Contacto
			</a>

			<MenuButton
				class="lg:hidden"
				aria-controls="mobile-menu"
				data-menu-toggle
			/>
		</div>
	</div>
</header>

<div
	id="mobile-menu"
	class="mobile-menu fixed inset-0 z-40 lg:hidden"
	data-mobile-menu
	aria-hidden="true"
	inert
>
	<button
		type="button"
		class="mobile-menu__backdrop absolute inset-0 border-0 bg-transparent"
		data-mobile-menu-backdrop
		tabindex="-1"
		aria-label="Cerrar menú"
	></button>

	<div class="mobile-menu__panel relative z-10 min-h-dvh border-t border-border-subtle bg-base pt-16" data-mobile-menu-panel>
		<div class="mx-auto flex min-h-[calc(100dvh-5rem)] max-w-7xl flex-col px-6 pb-[max(2.5rem,env(safe-area-inset-bottom))]">
			<div class="flex flex-1 flex-col items-center justify-center gap-10">
				<nav class="w-full max-w-md" aria-label="Menú móvil">
					<ul>
						{
							navLinks.map((link, index) => (
								<li class="border-b border-border-subtle">
									<a
										href={link.href}
										class="group flex w-full items-baseline gap-5 py-6 outline-none focus-visible:text-accent"
										data-menu-link
									>
										<span class="text-xs tracking-[0.3em] text-accent">
											{String(index + 1).padStart(2, '0')}
										</span>
										<span class="text-4xl font-light capitalize leading-none text-foreground transition-colors group-hover:text-accent">
											{link.label}
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<a
					href="/contacto"
					class="inline-flex w-full max-w-md items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-medium text-base transition-colors hover:bg-accent-muted outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-base"
					data-menu-link
				>
					Contacto
				</a>
			</div>

			<p class="pt-10 text-xs uppercase tracking-[0.24em] text-subtle">
				Tela y aro aéreo · Madrid
			</p>
		</div>
	</div>
</div>

<style>
	.mobile-menu {
		pointer-events: none;
		visibility: hidden;
	}

	.mobile-menu[data-open='true'] {
		pointer-events: auto;
		visibility: visible;
	}

	.mobile-menu__panel {
		opacity: 0;
		transform: translateY(-100%);
		transition:
			transform 500ms var(--ease-out),
			opacity 500ms ease-out,
			visibility 500ms;
		visibility: hidden;
	}

	.mobile-menu[data-open='true'] .mobile-menu__panel {
		opacity: 1;
		transform: translateY(0);
		visibility: visible;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu__panel {
			transform: none;
			transition: none;
		}

		.mobile-menu:not([data-open='true']) .mobile-menu__panel {
			opacity: 0;
			visibility: hidden;
		}

		.mobile-menu[data-open='true'] .mobile-menu__panel {
			opacity: 1;
			visibility: visible;
		}
	}
</style>

<script>
	const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
	const mobileMenuPanel = document.querySelector('[data-mobile-menu-panel]');
	const menuBackdrop = document.querySelector('[data-mobile-menu-backdrop]');
	const toggleButton = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
	const menuLinks = document.querySelectorAll('[data-menu-link]');
	const desktopNavQuery = window.matchMedia('(min-width: 1024px)');

	const focusableSelector =
		'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

	let previouslyFocused: HTMLElement | null = null;
	let focusTrapHandler: ((event: KeyboardEvent) => void) | null = null;

	const getFocusableElements = () => {
		if (!mobileMenu) return [];

		return [...mobileMenu.querySelectorAll<HTMLElement>(focusableSelector)].filter(
			(element) => !element.hasAttribute('disabled') && element.tabIndex !== -1,
		);
	};

	const removeFocusTrap = () => {
		if (focusTrapHandler) {
			document.removeEventListener('keydown', focusTrapHandler);
			focusTrapHandler = null;
		}
	};

	const addFocusTrap = () => {
		removeFocusTrap();

		focusTrapHandler = (event: KeyboardEvent) => {
			if (event.key === 'Escape') {
				setMenuOpen(false);
				return;
			}

			if (event.key !== 'Tab' || !mobileMenu) return;

			const focusables = getFocusableElements();
			if (focusables.length === 0) return;

			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			const activeElement = document.activeElement;

			if (event.shiftKey && activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		};

		document.addEventListener('keydown', focusTrapHandler);
	};

	const setMenuOpen = (open: boolean) => {
		if (!mobileMenu || !toggleButton || !mobileMenuPanel) return;

		toggleButton.setAttribute('aria-expanded', String(open));
		toggleButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		mobileMenu.setAttribute('data-open', String(open));
		mobileMenu.setAttribute('aria-hidden', String(!open));
		mobileMenu.toggleAttribute('inert', !open);
		document.body.classList.toggle('overflow-hidden', open);

		if (open) {
			previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			addFocusTrap();

			const focusables = getFocusableElements();
			const firstFocusable = focusables.find((element) => element.hasAttribute('data-menu-link'));
			(firstFocusable ?? focusables[0])?.focus();
			return;
		}

		removeFocusTrap();
		previouslyFocused?.focus();
		previouslyFocused = null;
	};

	toggleButton?.addEventListener('click', () => {
		setMenuOpen(toggleButton.getAttribute('aria-expanded') !== 'true');
	});

	menuBackdrop?.addEventListener('click', () => setMenuOpen(false));
	menuLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

	desktopNavQuery.addEventListener('change', (event) => {
		if (event.matches) {
			setMenuOpen(false);
		}
	});
</script>

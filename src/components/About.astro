---
import equipoImage from '../assets/equipo.webp';

const facts = [
	{ label: 'Disciplina', value: 'Tela y aro aéreo' },
	{ label: 'Enfoque', value: 'Entrenamiento, expresión y escena' },
	{ label: 'Formación', value: 'Clases y talleres de aéreos' },
	{ label: 'Shows', value: 'Discotecas y pubs' },
	{ label: 'Espectáculos', value: 'Mercadillos, ayuntamientos y festivales' },
	{ label: 'Base', value: 'Madrid' },
];
---

<section id="nosotros" class="border-t border-border-subtle px-6 py-16 sm:py-24">
	<div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-2 md:items-stretch md:gap-12 lg:gap-16">
		<div
			class="relative aspect-[4/5] overflow-hidden md:aspect-auto md:min-h-[20rem]"
			data-reveal
		>
			<img
				src={equipoImage.src}
				alt="Integrantes de Aeria Trois en actuación aérea"
				width={equipoImage.width}
				height={equipoImage.height}
				class="absolute inset-0 h-full w-full object-cover object-[50%_62%] md:object-[50%_58%]"
				loading="lazy"
			/>
		</div>

		<div class="flex flex-col justify-center">
			<p class="mb-2 text-xs tracking-[0.24em] text-subtle uppercase" data-reveal>
				El equipo artístico
			</p>

			<h2 class="text-3xl font-light text-foreground md:text-5xl" data-reveal>
				Tres aerealistas, una misma altura
			</h2>

			<p class="mt-4 max-w-xl text-sm leading-relaxed text-muted sm:mt-6" data-reveal>
				Somos un grupo artístico de Madrid especializado en tela y aro aéreo. Lydia, Paloma y Andrea
				combinan entrenamiento físico, expresión corporal y creación escénica en clases, talleres y
				espectáculos aéreos.
			</p>

			<dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 sm:mt-12 sm:grid-cols-3">
				{
					facts.map((fact) => (
						<div data-reveal>
							<dt class="text-xs tracking-[0.24em] text-foreground/80 uppercase">
								{fact.label}
							</dt>
							<dd class="mt-2 text-sm text-foreground">{fact.value}</dd>
						</div>
					))
				}
			</dl>

			<a
				href="/equipo"
				data-reveal
				class="mt-10 inline-flex min-h-11 w-fit items-center justify-center gap-2 rounded-full border border-border px-6 py-3 text-sm tracking-[0.12em] text-muted-soft uppercase transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:mt-12 [@media(pointer:coarse)]:min-h-12"
			>
				Conocer al equipo
				<svg
					class="h-3.5 w-3.5 shrink-0"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m13 6 6 6-6 6"></path>
				</svg>
			</a>
		</div>
	</div>
</section>

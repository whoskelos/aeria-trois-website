---
const formats = [
	{
		badge: 'Pase de entrada',
		title: 'Pase 5 Minutos',
		description:
			'Ideal para momentos estelares, aperturas de gala, inauguraciones o presentación de producto.',
		layout: 'dual',
	},
	{
		badge: 'Pase principal',
		title: 'Pase 10 Minutos',
		description:
			'Formato idóneo para cenas de gala, eventos corporativos y entregas de premios. También adecuado para pasacalles, puesto de espectáculo y ferias temáticas como mercadillos medievales.',
		layout: 'dual',
	},
	{
		badge: 'Pase premium',
		title: 'Pase 20 – 25 Minutos',
		description:
			'Producción completa con estructura narrativa y variedad de disciplinas aéreas.',
		layout: 'special',
	},
];

const packCounts = [2, 3, 4, 5];

const infrastructure = [
	{
		title: 'Estructura Autónoma',
		description:
			'Se incluye estructura aérea propia sin necesidad de anclajes. Requiere un espacio mínimo de 5×5 metros.',
		icon: 'expand',
	},
	{
		title: 'Desplazamiento CAM',
		description:
			'Transporte de equipo técnico y elenco incluido dentro de la Comunidad de Madrid.',
		icon: 'location',
	},
	{
		title: 'Vestuario Escénico',
		description:
			'Vestuario profesional incluido, con opción de vestir vestuario corporativo específico proporcionado por el cliente.',
		icon: 'shirt',
	},
	{
		title: 'Banda Sonora',
		description: 'Música sincronizada y coordinada con el equipo de sonido de la producción.',
		icon: 'music',
	},
];
---

<section id="modalidades" class="border-t border-border-subtle px-6 py-16 sm:py-24">
	<div class="mx-auto max-w-7xl">
		<div class="mb-10 flex flex-col gap-6 lg:mb-14 lg:flex-row lg:items-end lg:justify-between">
			<div class="max-w-xl">
				<p class="mb-2 text-xs tracking-[0.24em] text-subtle uppercase" data-reveal>
					Pases disponibles
				</p>
				<h2 class="text-3xl font-light text-foreground md:text-5xl" data-reveal>
					Modalidades y Packs
				</h2>
			</div>
			<p class="max-w-sm text-sm leading-relaxed text-muted lg:text-right" data-reveal>
				Diseñamos experiencias aéreas adaptadas a la escala de cada evento. Consulta las opciones de
				pases y contrataciones múltiples.
			</p>
		</div>

		<div class="space-y-6">
			{
				formats.map((format) => (
					<article
						class="rounded-lg border border-border bg-surface p-6 sm:p-8 lg:p-10"
						data-reveal
					>
						<span class="inline-block rounded-full border border-accent px-3 py-1 text-[0.625rem] tracking-[0.18em] text-accent uppercase">
							{format.badge}
						</span>

						<h3 class="mt-5 text-2xl font-light text-foreground sm:text-3xl">{format.title}</h3>
						<p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{format.description}</p>

						{format.layout === 'dual' ? (
							<div class="mt-8 grid gap-6 lg:grid-cols-2 lg:gap-8">
								<div class="rounded-lg border border-border bg-surface-raised p-5 sm:p-6">
									<div class="mb-5 flex items-center gap-2.5">
										<svg
											class="h-4 w-4 shrink-0 text-accent"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											aria-hidden="true"
										>
											<rect x="3" y="4" width="18" height="18" rx="2"></rect>
											<path d="M16 2v4M8 2v4M3 10h18"></path>
										</svg>
										<p class="text-[0.625rem] tracking-[0.18em] text-accent uppercase">
											Pack pases el mismo día
										</p>
									</div>
									<div class="grid grid-cols-2 gap-3">
										{packCounts.map((count) => (
											<div class="rounded border border-border bg-surface px-4 py-4 sm:px-5 sm:py-5">
												<p class="text-sm font-medium text-foreground">{count} Actuaciones</p>
												<p class="mt-1 text-xs text-muted">Misma jornada</p>
											</div>
										))}
									</div>
								</div>

								<div class="rounded-lg border border-border bg-surface-raised p-5 sm:p-6">
									<div class="mb-5 flex items-center gap-2.5">
										<svg
											class="h-4 w-4 shrink-0 text-accent"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											aria-hidden="true"
										>
											<rect x="3" y="4" width="18" height="18" rx="2"></rect>
											<path d="M16 2v4M8 2v4M3 10h18"></path>
										</svg>
										<p class="text-[0.625rem] tracking-[0.18em] text-accent uppercase">
											Pack pases diferentes días
										</p>
									</div>
									<div class="grid grid-cols-2 gap-3">
										{packCounts.map((count) => (
											<div class="rounded border border-border bg-surface px-4 py-4 sm:px-5 sm:py-5">
												<p class="text-sm font-medium text-foreground">{count} Actuaciones</p>
												<p class="mt-1 text-xs text-muted">Varias jornadas</p>
											</div>
										))}
									</div>
								</div>
							</div>
						) : (
							<div class="mt-8 rounded-lg border border-border bg-surface-raised p-5 sm:p-6">
								<div class="mb-5 flex items-center gap-2.5">
									<svg
										class="h-4 w-4 shrink-0 text-accent"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M12 2L2 7l10 5 10-5-10-5z"></path>
										<path d="M2 17l10 5 10-5"></path>
										<path d="M2 12l10 5 10-5"></path>
									</svg>
									<p class="text-[0.625rem] tracking-[0.18em] text-accent uppercase">
										Packs disponibles
									</p>
								</div>
								<div class="grid gap-3 sm:grid-cols-2">
									{[2, 3].map((count) => (
										<div class="rounded border border-border bg-surface px-4 py-4 sm:px-5 sm:py-5">
											<p class="text-sm font-medium text-foreground">{count} Actuaciones</p>
											<span class="mt-3 inline-block rounded border border-accent px-2 py-0.5 text-[0.5625rem] tracking-[0.14em] text-accent uppercase">
												Programación especial
											</span>
										</div>
									))}
								</div>
							</div>
						)}
					</article>
				))
			}
		</div>

		<div
			class="mt-10 flex flex-col gap-6 rounded-lg border border-border bg-surface-raised px-6 py-8 sm:px-8 sm:py-10 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
		>
			<div class="max-w-xl">
				<h3 class="text-xl font-light text-foreground sm:text-2xl" data-reveal>
					¿No encajan estos tiempos con lo que estás buscando?
				</h3>
				<p class="mt-3 text-sm leading-relaxed text-muted" data-reveal>
					Contáctanos y cuéntanos qué estás buscando para acercar nuestros servicios a tus
					expectativas.
				</p>
			</div>
			<a
				href="/contacto"
				data-reveal
				class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full border border-border px-6 py-3 text-sm text-muted-soft transition-colors hover:border-accent hover:text-accent"
			>
				Contactar
			</a>
		</div>

		<div class="mt-16 sm:mt-20">
			<div class="mb-10 max-w-2xl">
				<p class="mb-2 text-xs tracking-[0.24em] text-subtle uppercase" data-reveal>
					Servicios incluidos
				</p>
				<h2 class="text-3xl font-light text-foreground md:text-5xl" data-reveal>
					Infraestructura y Logística
				</h2>
				<p class="mt-4 text-sm leading-relaxed text-muted sm:text-[0.9375rem]" data-reveal>
					Todas las opciones de contratación incorporan una solución técnica integral y autónoma para
					garantizar la seguridad y agilidad en el evento.
				</p>
			</div>

			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
				{
					infrastructure.map((item) => (
						<article
							class="rounded-lg border border-border bg-surface p-5 sm:p-6"
							data-reveal
						>
							<div class="mb-4 flex h-9 w-9 items-center justify-center rounded border border-accent/40">
								{item.icon === 'expand' && (
									<svg
										class="h-4 w-4 text-accent"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
									</svg>
								)}
								{item.icon === 'location' && (
									<svg
										class="h-4 w-4 text-accent"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
										<circle cx="12" cy="10" r="3"></circle>
									</svg>
								)}
								{item.icon === 'shirt' && (
									<svg
										class="h-4 w-4 text-accent"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path>
									</svg>
								)}
								{item.icon === 'music' && (
									<svg
										class="h-4 w-4 text-accent"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path d="M9 18V5l12-2v13"></path>
										<circle cx="6" cy="18" r="3"></circle>
										<circle cx="18" cy="16" r="3"></circle>
									</svg>
								)}
							</div>
							<h3 class="text-sm font-medium text-foreground">{item.title}</h3>
							<p class="mt-2 text-xs leading-relaxed text-muted sm:text-sm">{item.description}</p>
						</article>
					))
				}
			</div>

			<div class="mt-10 flex flex-col gap-4 sm:mt-12 sm:flex-row sm:items-end sm:justify-between">
				<p class="max-w-md text-xs italic leading-relaxed text-subtle" data-reveal>
					*Dependiendo de la localización del evento u otras especificaciones técnicas, la propuesta
					podrá adaptarse.
				</p>
				<p
					class="shrink-0 text-[0.625rem] tracking-[0.18em] text-accent uppercase sm:text-right"
					data-reveal
				>
					Presupuestos a medida bajo petición
				</p>
			</div>
		</div>
	</div>
</section>

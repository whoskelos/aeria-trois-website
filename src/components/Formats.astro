---
const formats = [
	{
		name: 'Essential',
		description: 'Actuación aérea de 15 minutos con elenco reducido. Ideal para eventos íntimos.',
		features: ['2 artistas', 'Coreografía estándar', 'Coordinación técnica básica'],
	},
	{
		name: 'Premium',
		description: 'Espectáculo completo de 30 minutos con producción personalizada y música en vivo.',
		features: ['4–6 artistas', 'Coreografía a medida', 'Dirección artística incluida'],
		highlighted: true,
	},
	{
		name: 'Signature',
		description: 'Producción a gran escala para festivales y eventos de alto impacto mediático.',
		features: ['Elenco ampliado', 'Diseño escénico integral', 'Gestión logística completa'],
	},
];
---

<section id="modalidades" class="px-6 py-24">
	<div class="mx-auto max-w-7xl">
		<div class="mb-16 text-center">
			<p class="mb-2 text-sm text-accent">✦ Modalidades</p>
			<h2 class="text-3xl font-light text-foreground md:text-5xl">Packs y servicios</h2>
			<p class="mx-auto mt-4 max-w-xl text-muted">
				Tres formatos adaptables a la escala y el presupuesto de tu evento.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3">
			{
				formats.map((format) => (
					<article
						class:list={[
							'rounded-lg border p-8',
							format.highlighted
								? 'border-accent bg-surface-raised'
								: 'border-border bg-surface',
						]}
					>
						<h3 class="text-xl text-foreground">{format.name}</h3>
						<p class="mt-3 text-muted">{format.description}</p>
						<ul class="mt-6 space-y-2">
							{format.features.map((feature) => (
								<li class="flex items-center gap-2 text-sm text-muted-soft">
									<span class="text-accent" aria-hidden="true">✦</span>
									{feature}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

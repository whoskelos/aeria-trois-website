---
const highlights = [
	{ number: '01', title: 'Coreografía aérea', description: 'Secuencias sincronizadas con música y luces en vivo.' },
	{ number: '02', title: 'Elenco profesional', description: 'Artistas certificados con experiencia internacional.' },
	{ number: '03', title: 'Producción integral', description: 'Diseño, montaje, seguridad y coordinación técnica.' },
];
---

<section id="showcase" class="px-6 py-24">
	<div class="mx-auto max-w-7xl">
		<div class="mb-16 max-w-2xl">
			<p class="mb-2 text-sm text-accent">✦ Espectáculo</p>
			<h2 class="text-3xl font-light text-foreground md:text-5xl">El cielo como escenario</h2>
			<p class="mt-4 text-muted">
				Cada actuación combina precisión técnica y narrativa visual para crear momentos
				inolvidables sobre el público.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3">
			{
				highlights.map((item) => (
					<article class="rounded-lg border border-border bg-surface p-8">
						<span class="text-sm text-subtle">{item.number}</span>
						<h3 class="mt-4 text-xl text-foreground">{item.title}</h3>
						<p class="mt-3 text-muted">{item.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

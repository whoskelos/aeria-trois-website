---
import { Image } from 'astro:assets';
import type { GalleryMedia } from '../../lib/gallery';
import {
	bentoImageSizes,
	bentoPlacementClass,
	bentoPlacementStyle,
	bentoSpanClasses,
	type BentoAssignment,
} from '../../lib/bentoLayout';

interface Props {
	media: GalleryMedia;
	assignment: BentoAssignment;
	eventTitle: string;
	priority?: boolean;
}

const { media, assignment, eventTitle, priority = false } = Astro.props;
const { format } = assignment;
const placementStyle = bentoPlacementStyle(assignment);
---

<button
	type="button"
	class:list={[
		'experience-tile bento-cell group relative min-h-0 w-full overflow-hidden border border-border-subtle bg-surface p-0 text-left',
		'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
		bentoSpanClasses[format],
		bentoPlacementClass(assignment),
		format === 'hero' && 'experience-tile--hero',
	]}
	style={placementStyle}
	data-experience-item
	data-media-type={media.type}
	data-media-src={media.src}
	data-media-alt={media.alt}
	data-event-title={eventTitle}
	aria-label={`Ver ${media.type === 'video' ? 'video' : 'imagen'}: ${eventTitle}`}
>
	{
		media.type === 'video' ? (
			<video
				class="experience-tile__media absolute inset-0 h-full w-full object-cover"
				data-lazy-video
				data-src={media.src}
				muted
				loop
				playsinline
				preload="none"
				poster={media.poster}
			/>
		) : (
			<Image
				src={media.image!}
				alt={media.alt}
				widths={[400, 800, 1200]}
				sizes={bentoImageSizes(format)}
				layout="none"
				fit="cover"
				class="experience-tile__media absolute inset-0 h-full w-full object-cover"
				priority={priority}
			/>
		)
	}

	<div
		class:list={[
			'pointer-events-none absolute inset-0 bg-gradient-to-t from-base/80 via-base/10 to-transparent',
			format === 'hero' && 'from-base/90',
		]}
		aria-hidden="true"
	/>

	{
		media.type === 'video' && (
			<span
				class="pointer-events-none absolute bottom-4 left-4 flex items-center gap-2 text-xs tracking-[0.12em] text-foreground/90 uppercase sm:bottom-5 sm:left-5"
				aria-hidden="true"
			>
				<span class="flex h-8 w-8 items-center justify-center rounded-full border border-foreground/40 bg-base/30">
					<svg class="ml-0.5 h-3 w-3 fill-current" viewBox="0 0 24 24">
						<path d="M8 5v14l11-7z" />
					</svg>
				</span>
			</span>
		)
	}
</button>

<style>
	.experience-tile__media {
		transform: translate3d(0, 0, 0) scale(1.01);
		transition:
			opacity 400ms var(--ease-out),
			transform 400ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.experience-tile__media {
			opacity: 0.92;
		}

		.experience-tile:hover .experience-tile__media,
		.experience-tile:focus-visible .experience-tile__media {
			opacity: 1;
			transform: translate3d(0, 0, 0) scale(1.04);
		}

		.experience-tile--hero:hover .experience-tile__media,
		.experience-tile--hero:focus-visible .experience-tile__media {
			transform: translate3d(0, 0, 0) scale(1.03);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.experience-tile__media {
			transition: opacity 200ms ease;
		}

		.experience-tile:hover .experience-tile__media,
		.experience-tile:focus-visible .experience-tile__media {
			transform: none;
		}
	}
</style>

<section
	id="opiniones"
	class="testimonials-section border-t border-border-subtle px-6 py-16 sm:py-24"
	aria-labelledby="testimonials-heading"
	data-testimonials-section
>
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto max-w-3xl text-center">
			<p class="mb-2 text-xs tracking-[0.24em] text-subtle uppercase" data-reveal>
				Opiniones
			</p>

			<h2
				id="testimonials-heading"
				class="text-balance text-3xl font-light text-foreground md:text-5xl"
				data-reveal
			>
				Lo que dicen <span class="text-accent">quienes nos contratan</span>
			</h2>

			<p
				class="mx-auto mt-4 max-w-lg text-sm leading-relaxed text-muted sm:mt-6"
				data-reveal
			>
				Experiencias de quienes han confiado en Aeria Trois para sus eventos, festivales y galas.
			</p>

			<div class="mt-8 sm:mt-10" data-reveal>
				<a
					href="/review"
					class="inline-flex min-h-11 items-center justify-center rounded-full bg-accent px-8 py-3 text-sm font-medium tracking-[0.12em] text-base uppercase transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [@media(pointer:coarse)]:min-h-12"
				>
					Dejar una reseña
				</a>
			</div>
		</div>

		<div
			data-testimonials-loading
			class="testimonials-loading"
			role="status"
			aria-live="polite"
			aria-busy="true"
		>
			<div class="testimonials-loading__content">
				<svg
					class="testimonials-loading__spinner"
					viewBox="0 0 32 32"
					fill="none"
					aria-hidden="true"
				>
					<circle
						class="testimonials-loading__track"
						cx="16"
						cy="16"
						r="13"
						stroke="currentColor"
						stroke-width="2"
					></circle>
					<circle
						class="testimonials-loading__arc"
						cx="16"
						cy="16"
						r="13"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-dasharray="20 62"
					></circle>
				</svg>
				<p class="testimonials-loading__label">Cargando opiniones</p>
			</div>
		</div>

		<div data-testimonials-host hidden aria-hidden="true"></div>
	</div>
</section>

<div
	id="testimonial-modal"
	class="testimonial-modal fixed inset-0 z-[70] hidden items-center justify-center p-4 sm:p-6"
	aria-hidden="true"
	role="dialog"
	aria-modal="true"
	aria-labelledby="testimonial-modal-client"
>
	<button
		type="button"
		class="testimonial-modal__backdrop absolute inset-0 border-0 bg-base/92 backdrop-blur-sm"
		data-testimonial-modal-close
		aria-label="Cerrar"
	></button>

	<button
		type="button"
		class="absolute right-4 top-4 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-border-subtle bg-base/80 text-foreground transition-colors hover:border-accent hover:text-accent sm:right-6 sm:top-6"
		data-testimonial-modal-close
		data-testimonial-modal-close-button
		aria-label="Cerrar"
	>
		<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
			<path d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>

	<div
		class="testimonial-modal__panel relative z-10 flex max-h-[min(88dvh,40rem)] w-full max-w-2xl flex-col overflow-hidden rounded-xl border border-border bg-surface-raised"
	>
		<div class="overflow-y-auto px-6 py-8 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-8 sm:py-10">
			<svg
				class="testimonials-card__quote-icon mb-5"
				viewBox="0 0 32 24"
				fill="currentColor"
				aria-hidden="true"
			>
				<path
					d="M0 24V14.4C0 9.6 1.067 5.733 3.2 2.8 5.333-.133 8.267-1.6 12-1.6v4.8c-2.4 0-4.267.8-5.6 2.4-1.333 1.6-2 3.733-2 6.4h7.6V24H0Zm18 0V14.4c0-4.8 1.067-8.667 3.2-11.6C23.333-.133 26.267-1.6 30-1.6v4.8c-2.4 0-4.267.8-5.6 2.4-1.333 1.6-2 3.733-2 6.4H28V24H18Z"
				></path>
			</svg>

			<blockquote
				id="testimonial-modal-comment"
				class="testimonial-modal__comment font-serif text-lg leading-relaxed text-foreground sm:text-xl"
			></blockquote>

			<footer class="mt-8 flex flex-col gap-2.5 border-t border-border-subtle pt-6">
				<cite
					id="testimonial-modal-client"
					class="text-xs font-medium not-italic tracking-[0.2em] text-accent uppercase"
				></cite>
				<div id="testimonial-modal-stars" class="testimonials-card__stars" role="img" aria-hidden="true"></div>
			</footer>
		</div>
	</div>
</div>


---
import teamVideo from '../../assets/equipo.webm';
import teamStill from '../../assets/equipo-poster.webp';
import scenePreview1 from '../../assets/gallery/Festival-Enraizarte_Festival-Peñascosa-Albacete/shotbysiete-31.webp';
import scenePreview2 from '../../assets/gallery/Jowke-Racing_Jowke-Club_Madrid-EventoPrivado/DSC01049.webp';
import scenePreview3 from '../../assets/gallery/Jornadas-De-Bienestar_Ayto-Arroyomolinos_Arroyomolinos-Madrid/IMG_9960.webp';

const facts = [
	{ label: 'Disciplina', value: 'Tela y aro aéreo' },
	{ label: 'Enfoque', value: 'Entrenamiento, expresión y creación escénica' },
	{ label: 'Formación', value: 'Clases y talleres de aéreos' },
	{ label: 'Shows', value: 'Discotecas y pubs' },
	{ label: 'Espectáculos', value: 'Mercadillos, ayuntamientos, fiestas patronales y festivales' },
	{ label: 'Base', value: 'Madrid' },
];

const scenePreviews = [
	{ title: 'Festival Enraizarte', image: scenePreview1 },
	{ title: 'Jowke Racing', image: scenePreview2 },
	{ title: 'Jornadas de Bienestar', image: scenePreview3 },
];
---

<section class="border-b border-border-subtle px-6 py-14 sm:py-20">
	<div class="mx-auto max-w-7xl">
		<div class="grid gap-10 md:grid-cols-2 md:items-stretch md:gap-12 lg:gap-16">
			<div class="flex flex-col md:h-full">
				<p class="mb-2 text-xs tracking-[0.24em] text-subtle uppercase" data-reveal>
					Quiénes somos
				</p>
				<h2 class="text-3xl font-light text-foreground md:text-5xl" data-reveal>
					Aeria Trois en escena
				</h2>
				<p class="mt-4 max-w-xl text-sm leading-relaxed text-muted sm:mt-6" data-reveal>
					Somos un grupo artístico de Madrid especializado en tela y aro aéreo. Integrado por tres
					artistas — Lydia, Paloma y Andrea — el proyecto combina entrenamiento físico, expresión
					corporal y creación escénica, desarrollando tanto actividades formativas como espectáculos y
					shows aéreos.
				</p>

				<dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 sm:mt-12 sm:grid-cols-3">
					{
						facts.map((fact) => (
							<div data-reveal>
								<dt class="text-xs tracking-[0.24em] text-foreground/80 uppercase">{fact.label}</dt>
								<dd class="mt-2 text-sm text-foreground">{fact.value}</dd>
							</div>
						))
					}
				</dl>

				<div class="mt-auto border-t border-border-subtle pt-8 sm:pt-10" data-reveal>
					<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
						<p class="max-w-xs text-sm leading-relaxed text-muted">
							Fuerza, línea y altura. Así actuamos juntas en escena.
						</p>
						<a
							href="/experiencias"
							class="inline-flex min-h-11 shrink-0 items-center gap-2 text-sm tracking-[0.12em] text-muted-soft uppercase transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
						>
							Ver experiencias
							<svg
								class="h-3.5 w-3.5 shrink-0"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<path d="M5 12h14"></path>
								<path d="m13 6 6 6-6 6"></path>
							</svg>
						</a>
					</div>
					<div class="mt-5 grid grid-cols-3 gap-3">
						{
							scenePreviews.map((item) => (
								<a
									href="/experiencias"
									class="group relative aspect-[3/4] overflow-hidden bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
									aria-label={`Ver experiencia: ${item.title}`}
								>
									<img
										src={item.image.src}
										alt=""
										width={item.image.width}
										height={item.image.height}
										class="scene-preview__image absolute inset-0 h-full w-full object-cover"
										loading="lazy"
									/>
									<div
										class="pointer-events-none absolute inset-0 bg-gradient-to-t from-base/80 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
										aria-hidden="true"
									></div>
									<span
										class="pointer-events-none absolute inset-x-0 bottom-0 px-2 pb-2 text-[0.625rem] leading-snug tracking-[0.08em] text-foreground uppercase opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
									>
										{item.title}
									</span>
								</a>
							))
						}
					</div>
				</div>
			</div>

			<div
				class="flex min-h-[min(50svh,28rem)] min-w-0 flex-col bg-base md:min-h-0 md:h-full"
				data-reveal
			>
				<div class="flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-base">
					<video
						class="max-h-full max-w-full object-contain object-center"
						controls
						playsinline
						preload="metadata"
						poster={teamStill.src}
						src={teamVideo}
						aria-label="Vídeo de presentación de Aeria Trois con Lydia, Paloma y Andrea"
					></video>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@media (hover: hover) and (pointer: fine) {
		.scene-preview__image {
			transform: translate3d(0, 0, 0) scale(1.01);
			transition:
				opacity 400ms var(--ease-out),
				transform 400ms var(--ease-out);
			opacity: 0.92;
		}

		a.group:hover .scene-preview__image,
		a.group:focus-visible .scene-preview__image {
			opacity: 1;
			transform: translate3d(0, 0, 0) scale(1.04);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scene-preview__image {
			transition: opacity 200ms ease;
		}

		a.group:hover .scene-preview__image,
		a.group:focus-visible .scene-preview__image {
			transform: none;
		}
	}
</style>

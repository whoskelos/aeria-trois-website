---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';

const description = 'Aviso legal de Aeria Trois: identificación, uso del sitio y condiciones de las reseñas.';
---

<Layout title="Aviso legal" description={description} canonicalPath="/aviso-legal">
	<Header />
	<main
		class="pt-[calc(3.75rem+env(safe-area-inset-top,0px))] lg:pt-[calc(4rem+env(safe-area-inset-top,0px))]"
	>
		<article class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
			<h1 class="text-balance text-3xl font-light text-foreground md:text-5xl" data-reveal>
				Aviso <span class="text-accent">legal</span>
			</h1>
			<p class="mt-4 text-sm leading-relaxed text-muted sm:mt-6" data-reveal>
				Este sitio presenta el trabajo de {siteConfig.name} en {siteConfig.location.locality} y
				España.
			</p>
			<div class="mt-10 space-y-5 text-sm leading-relaxed text-muted-soft" data-reveal>
				<p>
					Los contenidos (textos, imágenes, vídeos y marcas) pertenecen a {siteConfig.name} salvo
					indicación contraria. No está permitido copiarlos o reutilizarlos sin permiso.
				</p>
				<p>
					Las reseñas que envíes deben referirse a una experiencia real. No publiques datos de
					terceros, insultos ni contenido ilegal. Nos reservamos el derecho de no publicar un
					texto que no cumpla estas condiciones.
				</p>
				<p>
					Para cualquier cuestión legal o de contratación:
					<a
						class="text-accent underline decoration-1 underline-offset-4 hover:text-accent-muted"
						href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a
					>.
				</p>
			</div>
			<p class="mt-12" data-reveal>
				<a
					href="/review"
					class="inline-flex min-h-11 items-center justify-center rounded-full border border-border px-6 py-3 text-sm tracking-[0.12em] text-muted-soft uppercase transition-colors hover:border-accent hover:text-accent"
				>
					Volver a la reseña
				</a>
			</p>
		</article>
	</main>
	<Footer />
</Layout>

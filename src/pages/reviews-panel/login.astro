---
import ReviewPanelLayout from '../../layouts/ReviewPanelLayout.astro';
import { getReviewerSession } from '../../lib/reviewPanelAuth';
import { createSupabaseAuthClient } from '../../lib/supabaseAuth';

export const prerender = false;

const supabase = createSupabaseAuthClient(Astro.request, Astro.cookies);
const session = await getReviewerSession(supabase);

if (session) {
	return Astro.redirect('/reviews-panel');
}
---

<ReviewPanelLayout title="Acceso al panel">
	<main class="panel-login-page">
		<div class="panel-login-page__inner">
			<header class="panel-login-page__header">
				<h1 class="panel-login-page__title">Panel de reseñas</h1>
				<p class="panel-login-page__subtitle">Acceso restringido para moderación.</p>
			</header>

			<form class="panel-login" data-panel-login novalidate>
				<div class="panel-login__field">
					<label class="panel-login__label" for="panel-username">Usuario</label>
					<input
						class="panel-login__input"
						id="panel-username"
						name="username"
						type="text"
						autocomplete="username"
						autocapitalize="none"
						spellcheck="false"
						required
					/>
				</div>

				<div class="panel-login__field">
					<label class="panel-login__label" for="panel-password">Contraseña</label>
					<input
						class="panel-login__input"
						id="panel-password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
					/>
				</div>

				<p class="panel-login__error" data-login-error hidden role="alert"></p>

				<button class="panel-login__submit" type="submit">Entrar</button>
			</form>
		</div>
	</main>
</ReviewPanelLayout>

<style>
	.panel-login-page {
		display: flex;
		min-height: 100dvh;
		align-items: center;
		justify-content: center;
		padding: max(1.5rem, env(safe-area-inset-top)) var(--panel-gutter, 1rem)
			max(2rem, env(safe-area-inset-bottom));
	}

	.panel-login-page__inner {
		width: 100%;
		max-width: 24rem;
	}

	.panel-login-page__header {
		text-align: center;
	}

	.panel-login-page__title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.panel-login-page__subtitle {
		margin: 0.5rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.panel-login {
		display: grid;
		gap: 1.125rem;
		margin-top: 2rem;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.875rem;
		background: var(--color-surface-raised);
	}

	@media (min-width: 640px) {
		.panel-login {
			padding: 1.75rem;
			border-radius: 1rem;
		}
	}

	.panel-login__field {
		display: grid;
		gap: 0.375rem;
	}

	.panel-login__label {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-muted-soft);
	}

	.panel-login__input {
		width: 100%;
		min-height: var(--panel-touch, 2.75rem);
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.625rem;
		background: var(--color-surface);
		color: var(--color-foreground);
		font: inherit;
		font-size: 1rem;
		-webkit-tap-highlight-color: transparent;
	}

	.panel-login__input:focus {
		outline: 2px solid rgb(226 184 87 / 0.45);
		outline-offset: 2px;
		border-color: rgb(226 184 87 / 0.35);
	}

	.panel-login__error {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.5;
		color: #f87171;
	}

	.panel-login__submit {
		margin-top: 0.25rem;
		min-height: var(--panel-touch, 2.75rem);
		padding: 0 1rem;
		border: none;
		border-radius: 0.625rem;
		background: var(--color-accent);
		color: var(--color-base);
		font: inherit;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		transition: filter 150ms ease;
	}

	.panel-login__submit:active {
		filter: brightness(0.95);
	}

	.panel-login__submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-panel-login]');
	const errorEl = document.querySelector<HTMLElement>('[data-login-error]');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form || !errorEl) return;

		const formData = new FormData(form);
		const username = String(formData.get('username') ?? '');
		const password = String(formData.get('password') ?? '');
		const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

		errorEl.hidden = true;
		errorEl.textContent = '';
		submitButton?.setAttribute('disabled', 'true');

		try {
			const response = await fetch('/api/reviews-panel/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ username, password }),
			});

			const result = (await response.json()) as { ok?: boolean; error?: string };

			if (!response.ok || !result.ok) {
				errorEl.textContent = result.error ?? 'Credenciales incorrectas.';
				errorEl.hidden = false;
				return;
			}

			window.location.href = '/reviews-panel';
		} catch {
			errorEl.textContent = 'No se pudo iniciar sesión. Inténtalo de nuevo.';
			errorEl.hidden = false;
		} finally {
			submitButton?.removeAttribute('disabled');
		}
	});
</script>

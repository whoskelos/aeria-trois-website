---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import TeamHero from '../components/team/TeamHero.astro';
import TeamStory from '../components/team/TeamStory.astro';
import TeamCarousel from '../components/team/TeamCarousel.astro';

const description =
	'Conoce a Lydia, Paloma y Andrea: el trío de Aeria Trois en tela y aro aéreo. Formación, shows y espectáculos en Madrid.';
---

<Layout title="Equipo" description={description} canonicalPath="/equipo">
	<Header />
	<main
		class="pt-[calc(3.75rem+env(safe-area-inset-top,0px))] lg:pt-[calc(4rem+env(safe-area-inset-top,0px))]"
	>
		<TeamHero />
		<TeamStory />
		<TeamCarousel />
		<CallToAction
			titleLine="¿Quieres reservar un número"
			titleAccent="con Aeria Trois?"
			description="Lydia, Paloma y Andrea adaptan tela y aro a tu espacio, público y escala. Cuéntanos la fecha y el tipo de evento."
		/>
	</main>
	<Footer />
</Layout>

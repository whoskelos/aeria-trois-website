---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import introPoster from '../assets/intro-poster.webp';
import ServicesTicker from '../components/ServicesTicker.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Collaborations from '../components/Collaborations.astro';
import Testimonials from '../components/Testimonials.astro';
import Formats from '../components/Formats.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<link slot="head" rel="preload" as="image" href={introPoster.src} fetchpriority="high" />
	<Header />
	<main>
		<Hero />
		<ServicesTicker />
		<Gallery />
		<About />
		<Collaborations />
		<Testimonials />
		<Formats />
		<CallToAction />
	</main>
	<Footer />
</Layout>

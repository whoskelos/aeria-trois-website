{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"headers": [
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(favicon\\.ico|apple-touch-icon\\.png|favicon-16x16\\.png|favicon-32x32\\.png|android-chrome-192x192\\.png|android-chrome-512x512\\.png|og\\.jpg|site\\.webmanifest)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		}
	]
}

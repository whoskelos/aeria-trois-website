{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"headers": [
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/favicon.ico",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400"
				}
			]
		},
		{
			"source": "/(.*\\.(?:png|jpg|jpeg|webp|woff2|webmanifest))",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800"
				}
			]
		}
	]
}

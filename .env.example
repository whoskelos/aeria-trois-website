# Supabase — copy from Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key

# Server-only: used to hash client IP for rate limiting (never expose to the browser)
REVIEW_CLIENT_KEY_SALT=generate_a_long_random_secret

# Server-only: moderation / admin operations (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Reviews panel: must match the Supabase Auth user (server-only, do not commit real values)
REVIEW_PANEL_AUTH_EMAIL=your-reviewer@your-project.internal
REVIEW_PANEL_LOGIN_USERNAME=your-reviewer-username

# Also configure these in Vercel → Project Settings → Environment Variables
